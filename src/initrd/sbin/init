#!/bin/sh

# LeafOS Installer Init Script
# Runs as PID 1 in the initrd environment

echo "LeafOS Installer Init Starting..."

# Mount kernel filesystems required by the installer
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev

# Set up PATH for finding commands
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export TERM=linux

# Set hostname
hostname leafos-installer

echo "Environment initialized"
echo ""

# Run the installer
exec /usr/sbin/installer
